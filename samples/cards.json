        if("0" == "1"){
            $(".ans-cc").children().each(function() {
                try {
                    if ($(this).has('br').length && ($(this).html().trim() == "<br>" || $(this).html().trim() == "<br/>") 
                            && !$(this).has('iframe').length){
                        $(this).attr("tabindex","-1");
                        $(this).attr("aria-hidden",true);
                    } else {
                        $(this).attr("tabindex","0")
                        $(this).attr("role","option")
                    }

                    // 无障碍特殊处理
                    if ($(this).hasClass("draghandle") && $(this).attr("title") == "拖动可排序") {
                        $(this).attr("tabindex", "-1");
                        $(this).attr("aria-hidden",true);
                    }

                    // 空标签情况
                    if ($(this).html().trim() == "" && !$(this).has('iframe').length) {
                        $(this).attr("tabindex", "-1");
                        $(this).attr("aria-hidden",true);
                    }


                    // 图片读取处理
                    if ($(this).has('img').length){
                        $(this).find('img').each(function() {
                            var title = $(this).attr("title");
                            if (title) {
                                var arr = title.split('.');
                                if (arr.length > 1){
                                    $(this).attr("aria-label", arr[0]);
                                }
                            }
                        });
                    }
                } catch (e) {

                }
            });

            try {
                if (window.top && window.top.accessiblePlugs) {
                    // window.top.accessiblePlugs.taggeriframe();
                    window.top.accessiblePlugs.update();
                }
            } catch (e) {
                console.log(e)
            }
        }

