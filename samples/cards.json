    function modularArrClick(obj) {
        if($(obj).hasClass("slideDown")){
            $(obj).removeClass("slideDown");
            $(obj).parent().parent().find('iframe').css('display', 'block');
            $(obj).parent().find(".modularVideoTime").css('display', 'none');
            $(obj).find("span").text("收起");
        } else {
            $(obj).addClass("slideDown");
            $(obj).parent().parent().find('iframe').css('display', 'none');
            $(obj).find("span").text("展开");
            $(obj).parent().find(".modularVideoTime").css('display', 'block');
        }
    }
    function parentModularArrClick(obj) {
        $(obj).parent('.video-file-modularTitle').css('display', 'none');
        $(obj).parent('.video-file-modularTitle').parent().find('iframe').css('display', 'block');
