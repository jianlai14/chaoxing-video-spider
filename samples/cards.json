    <script type="text/javascript">
        function openAiAssistantForSelectedText(selectedText) {
            var qaModel = Number(document.getElementById('qaModel').value) || 0;
            if (qaModel !== 1) {
                if (typeof parent.openCozeBotForText === 'function') {
                    parent.openCozeBotForText(selectedText);
                }
                return;
            }

            var robotReady = parent.chaoxingRobotReady || parent.chaoxingRobot;
            if (!robotReady && typeof parent.initializeRobot === 'function') {
                robotReady = parent.initializeRobot();
            }
            if (!robotReady) {
                console.error('Course AI assistant is unavailable');
                return;
            }

            Promise.resolve(robotReady).then(function (robot) {
                robot = robot || parent.chaoxingRobot;
                if (!robot) {
                    throw new Error('Robot instance is unavailable');
                }
                if (typeof robot._openWin === 'function') {
                    robot._openWin();
                }
                if (parent.chaoxingRobotWsConnected || !parent.chaoxingRobotWsReady) {
                    return robot;
                }
                return Promise.resolve(parent.chaoxingRobotWsReady).then(function (connectedRobot) {
                    return connectedRobot || robot;
                });
            }).then(function (robot) {
                if (typeof robot.invoke !== 'function') {
                    throw new Error('Robot invoke API is unavailable');
                }
                return robot.invoke('inputText', {text: selectedText});
            }).catch(function (error) {
                console.error('chaoxingRobot inputText error:', error);
            });
        }
    </script>
